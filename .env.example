LISTEN_ADDR=127.0.0.1:8787
DATA_DIR=./data
FRONTEND_DIR=./frontend/dist
RESPONSES_BASE_URL=https://api.openai.com/v1
LLM_API_STYLE=responses
# DeepSeek also supports responses: RESPONSES_BASE_URL=https://api.deepseek.com
RESPONSES_API_KEY=
RESPONSES_MODEL=
RESPONSES_STRUCTURED_OUTPUT=true
RESPONSES_TIMEOUT_SECONDS=300
TTS_PROVIDER=openai
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=
# Blank selects marin for OpenAI, Aoede for Gemini / OpenRouter.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
TTS_TIMEOUT_SECONDS=180
TRANSLATION_BATCH_CHARS=2400
TTS_CONCURRENCY=2
FFMPEG_PATH=
# Optional pure-Go FLAC decoding supports playback without FFmpeg.
# Tests use a dedicated command with fake providers; production never enables them.
