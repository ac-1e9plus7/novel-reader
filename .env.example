# Starting point copied by the setup scripts. This is not the recommended provider preset.
# Built-in defaults apply when values are missing or blank; see docs/configuration.md.
# Recommended DeepSeek + OpenRouter Gemini preset: config/deepseek-gemini.env.example

LISTEN_ADDR=127.0.0.1:8787
DATA_DIR=./data
FRONTEND_DIR=./frontend/dist

# Translation: Responses API (recommended) or explicit chat_completions.
LLM_API_STYLE=responses
RESPONSES_BASE_URL=https://api.openai.com/v1
# DeepSeek also supports the Responses API: RESPONSES_BASE_URL=https://api.deepseek.com
RESPONSES_API_KEY=
RESPONSES_MODEL=
RESPONSES_STRUCTURED_OUTPUT=true
RESPONSES_TIMEOUT_SECONDS=300

# TTS provider: openai, openrouter, or azure.
TTS_PROVIDER=openai
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=
# Blank selects marin for OpenAI; Aoede only for OpenRouter with google/gemini-* models.
TTS_TIMEOUT_SECONDS=180
TTS_CONCURRENCY=10

# Azure Speech: set TTS_PROVIDER=azure and fill the three values below.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural

FFMPEG_PATH=
# Optional pure-Go FLAC decoding supports playback without FFmpeg.
# Browser tests use backend/cmd/testserver with fake providers, not these settings.
