# Recommended provider preset: DeepSeek Responses + OpenRouter Gemini TTS.
# Copy selected entries into the project .env. This file is not copied automatically.
# Never commit real keys. Full reference: docs/configuration.md

LLM_API_STYLE=responses
RESPONSES_BASE_URL=https://api.deepseek.com
RESPONSES_API_KEY=
RESPONSES_MODEL=deepseek-flash
RESPONSES_STRUCTURED_OUTPUT=true
RESPONSES_TIMEOUT_SECONDS=300

TTS_PROVIDER=openrouter
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_API_KEY=
TTS_MODEL=google/gemini-3.8-flash-tts
# Female voice with breezy delivery. Alternative: Sulafat (warm).
TTS_VOICE=Aoede
TTS_TIMEOUT_SECONDS=180
TTS_CONCURRENCY=10
